# ─── Server ───────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite for local dev (default). Swap to PostgreSQL for production:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/glowly
DATABASE_URL=sqlite+aiosqlite:///./glowly.db

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Model used for vision + analysis (claude-sonnet-4-6 supports vision)
CLAUDE_VISION_MODEL=claude-sonnet-4-6
# Model used for cheaper text-only tasks (categorization, chat)
CLAUDE_CHAT_MODEL=claude-haiku-4-5-20251001

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Used only for text-embedding-3-small (RAG embeddings)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Use ":memory:" for local dev, or a real URL for production
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_USE_MEMORY=true
QDRANT_COLLECTION=glowly_knowledge

# ─── LangSmith ────────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=glowly-backend
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── RAG ──────────────────────────────────────────────────────────────────────
# Minimum confidence to auto-save; below this routes to human_confirmation
CONFIDENCE_THRESHOLD=0.75
RAG_TOP_K=3
